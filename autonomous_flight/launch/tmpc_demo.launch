<launch>
  <arg name="enable_rviz" default="true"/>
  <arg name="nav_launch_prefix" default=""/>

  <!-- ═══════════════════════════════════════════════════════════════════════
       T-MPC++ demo launch file
       Topology-driven MPC (de Groot et al., IEEE T-RO 2025). Benchmark method
       id M6_tmpc. Mirrors im2_mppi_demo.launch but starts tmpc_navigation_node
       and loads the T-MPC++ planner parameters (+ vendored guidance_planner cfg).
       See trajectory_planner/docs/TMPC_INTEGRATION.md
  ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- Tracking controller parameters -->
  <rosparam file="$(find tracking_controller)/cfg/controller_param.yaml"
            ns="controller"/>

  <!-- Fake detector parameters (used when use_fake_detector: true) -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/fake_detector_param.yaml"/>

  <!-- Flight base parameters (simulation, takeoff height, velocities, etc.) -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/flight_base.yaml"
            ns="autonomous_flight"/>

  <!-- Map manager parameters -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/mapping_param.yaml"
            ns="/dynamic_map"/>

  <!-- Onboard detector parameters -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/dynamic_detector_param.yaml"
            ns="/onboard_detector"/>

  <!-- Dynamic predictor parameters (present for parity; T-MPC++ uses constant-velocity) -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/predictor_param.yaml"
            ns="/dynamic_predictor"/>

  <!-- T-MPC++ planner parameters (all keys live under the "tmpc" namespace) -->
  <rosparam file="$(find trajectory_planner)/cfg/tmpc.yaml"/>

  <!-- Vendored guidance_planner config (uncomment after cloning tud-amr/guidance_planner).
       The guidance planner reads GuidancePlanner::Config::N / ::DT from this file; keep
       N*DT consistent with tmpc.yaml horizon_steps*dt for a fair comparison. -->
  <!-- <rosparam file="$(find guidance_planner)/config/params.yaml"/> -->
  <!-- <rosparam file="$(find guidance_planner)/config/guidance_planner.yaml"/> -->

  <!-- ─── Nodes ──────────────────────────────────────────────────────────── -->

  <!-- Low-level tracking controller (unchanged) -->
  <node pkg="tracking_controller"
        type="tracking_controller_node"
        name="tracking_controller_node"
        output="screen"/>

  <!-- T-MPC++ navigation node -->
  <node pkg="autonomous_flight"
        type="tmpc_navigation_node"
        name="tmpc_navigation_node"
        launch-prefix="$(arg nav_launch_prefix)"
        output="screen"/>

  <!-- RViz (reuse the IM2-MPPI rviz config; T-MPC++ topics live under /tmpc) -->
  <group if="$(arg enable_rviz)">
    <node pkg="trajectory_planner"
          type="filter_visible_dynamic_bboxes.py"
          name="visible_dynamic_bbox_filter"
          output="screen">
      <param name="input_topic" value="/onboard_detector/GT_obstacle_bbox"/>
      <param name="output_topic" value="/onboard_detector/visible_dynamic_bboxes"/>
    </node>
    <node pkg="rviz"
          type="rviz"
          name="tmpc_rviz"
          args="-d $(find autonomous_flight)/cfg/tmpc_navigation.rviz"
          required="false"/>
  </group>

</launch>
