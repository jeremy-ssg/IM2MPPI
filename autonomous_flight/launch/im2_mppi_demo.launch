<launch>
  <!-- ═══════════════════════════════════════════════════════════════════════
       IM2-MPPI demo launch file
       Mirrors intent_mpc_demo.launch but replaces mpc_navigation_node with
       im2_mppi_navigation_node.  The original intent_mpc_demo.launch is
       untouched and can still be run independently.
  ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- Tracking controller parameters -->
  <rosparam file="$(find tracking_controller)/cfg/controller_param.yaml"
            ns="controller"/>

  <!-- Fake detector parameters (used when use_fake_detector: true) -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/fake_detector_param.yaml"/>

  <!-- Flight base parameters (simulation, takeoff height, velocities, etc.) -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/flight_base.yaml"
            ns="autonomous_flight"/>

  <!-- Map manager parameters -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/mapping_param.yaml"
            ns="/dynamic_map"/>

  <!-- Onboard detector parameters -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/dynamic_detector_param.yaml"
            ns="/onboard_detector"/>

  <!-- Dynamic predictor parameters (intent probabilities, prediction horizon) -->
  <rosparam file="$(find autonomous_flight)/cfg/mpc_navigation/predictor_param.yaml"
            ns="/dynamic_predictor"/>

  <!-- IM2-MPPI planner parameters (all keys live under the "im2_mppi" namespace) -->
  <rosparam file="$(find trajectory_planner)/cfg/im2_mppi.yaml"/>

  <!-- ─── Nodes ──────────────────────────────────────────────────────────── -->

  <!-- Low-level tracking controller (unchanged from original pipeline) -->
  <node pkg="tracking_controller"
        type="tracking_controller_node"
        name="tracking_controller_node"
        output="screen"/>

  <!-- IM2-MPPI navigation node (replaces mpc_navigation_node) -->
  <node pkg="autonomous_flight"
        type="im2_mppi_navigation_node"
        name="im2_mppi_navigation_node"
        output="screen"/>

  <!-- RViz (reuse the same rviz config as the original MPC demo) -->
  <include file="$(find remote_control)/launch/mpc_navigation_rviz.launch"/>

</launch>
