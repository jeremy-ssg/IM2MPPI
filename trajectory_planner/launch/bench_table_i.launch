<launch>
  <!-- ════════════════════════════════════════════════════════════════════
       Minimal launch for Table I per-stage planner timing benchmark.

       Mirrors the canonical IM2-MPPI launch pattern from
       run_all_experiments.sh (run_one() at line ~188), namely:

           roslaunch uav_simulator start.launch
           roslaunch autonomous_flight im2_mppi_demo.launch

       The ONLY addition is a <param> that sets the path the
       instrumented planner appends one JSON line per plan() tick to.
       The param is declared BEFORE the include so it sits on the
       rosparam server before im2_mppi_navigation_node constructs.

       This deliberately keeps im2_mppi_demo.launch's RViz config
       (im2_mppi_navigation.rviz) — which only renders the detector's
       FOV-filtered dynamic-obstacle bboxes, NOT every world obstacle.
       That is the lightweight visualisation the production benchmark
       has always used.

       Usage:
         roslaunch trajectory_planner bench_table_i.launch \
                 stage_timing_log:=/tmp/im2_stage.jsonl

         # Fully headless (no Gazebo client, no RViz):
         roslaunch trajectory_planner bench_table_i.launch \
                 stage_timing_log:=/tmp/im2_stage.jsonl \
                 gui:=false enable_rviz:=false
  ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ─── Args ─────────────────────────────────────────────────────────── -->

  <!-- Path the instrumented planner appends one JSON line per plan() tick to.
       Empty string => instrumentation no-ops, table will report zero ticks. -->
  <arg name="stage_timing_log" default="/tmp/im2_stage.jsonl"/>

  <!-- Pass-through to start.launch / im2_mppi_demo.launch. Defaults match
       run_all_experiments.sh so the obstacle visualisation behaviour is
       identical to the benchmark runs the paper actually reports. -->
  <arg name="gui"         default="true"/>
  <arg name="enable_rviz" default="true"/>

  <!-- Optional world override (matches run_all_experiments.sh WORLD_FILE). -->
  <arg name="world_name"
       default="$(find uav_simulator)/worlds/generated_env/generated_env.world"/>

  <!-- Match the paper's CVaR-MPPI production config (M4_im2_full). -->
  <arg name="method_type" default="cvar_mppi"/>
  <arg name="fusion_mode" default="adaptive"/>
  <arg name="random_seed" default="1"/>

  <!-- ─── Stage-timing param (read by instrumented planner) ───────────── -->
  <!-- Declared BEFORE the includes so it's on the master by the time
       im2_mppi_navigation_node constructs and calls loadParams(). -->

  <param name="im2_mppi/stage_timing_log" type="string"
         value="$(arg stage_timing_log)"/>

  <!-- ─── Simulator stack (verbatim from run_all_experiments.sh) ──────── -->

  <include file="$(find uav_simulator)/launch/start.launch">
    <arg name="gui"        value="$(arg gui)"/>
    <arg name="world_name" value="$(arg world_name)"/>
  </include>

  <!-- ─── Planner stack (verbatim from run_all_experiments.sh) ────────── -->
  <!-- im2_mppi_demo.launch handles ALL the rosparams + nodes
       (tracking_controller, im2_mppi_navigation_node, RViz) and uses
       the production im2_mppi_navigation.rviz config that renders the
       detector's FOV-filtered bboxes only. -->

  <include file="$(find autonomous_flight)/launch/im2_mppi_demo.launch">
    <arg name="enable_rviz" value="$(arg enable_rviz)"/>
  </include>

  <!-- Override the three planner knobs the paper-config table assumes.
       Declared AFTER the include so they take precedence over
       im2_mppi.yaml's defaults. -->
  <param name="im2_mppi/method_type" value="$(arg method_type)"/>
  <param name="im2_mppi/fusion_mode" value="$(arg fusion_mode)"/>
  <param name="im2_mppi/random_seed" value="$(arg random_seed)"/>

</launch>
