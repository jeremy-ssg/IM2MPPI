<sdf version='1.7'>
  <!--
    Intent-uncertain benchmark world.

    Dynamic pedestrian-only scene with 45 branching pedestrians.  The planner-
    side static prebuilt map is disabled by the intent-uncertain launch files.

    The quadcopter starts at (0, 7).  Pedestrian paths are kept outside a
    3.5 m start exclusion radius so launch/takeoff collisions do not
    dominate the benchmark before the planner has a meaningful decision to make.

    Every pedestrian has a branch_point with multiple possible future routes.
    obstaclePathPlugin samples one branch per pedestrian at Gazebo load time
    using OBS_BRANCH_SEED mixed with the model name hash.  Thus each seed gives
    every compared planner the same realized pedestrian motions, while a seed
    sweep covers many intent combinations.
  -->
  <world name='default'>

    <!-- Pedestrian 1: side vertical crossing with straight/outer/far-outer intents.  Start-zone clearance >= 8.60 m. -->
    <model name="person01_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.45</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>-8.60 -8.60 0.00</waypoint>
          <waypoint>-8.60 -3.50 0.00</waypoint>
          <waypoint>-8.60 0.00 0.00</waypoint>
          <branch_point>
            <choice prob="0.50">
              <waypoint>-8.60 8.30 0.00</waypoint>
            </choice>
            <choice prob="0.25">
              <waypoint>-10.00 0.80 0.00</waypoint>
              <waypoint>-10.00 8.30 0.00</waypoint>
            </choice>
            <choice prob="0.25">
              <waypoint>-11.20 -0.80 0.00</waypoint>
              <waypoint>-11.20 8.30 0.00</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

