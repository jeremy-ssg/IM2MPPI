<sdf version='1.7'>
  <!--
    Intent-uncertain benchmark world (3 pedestrians, 2 of them branching).

    Each launch of Gazebo, the obstaclePathPlugin samples ONE choice per
    <branch_point> based on env OBS_BRANCH_SEED ⊕ hash(model_name).  Over
    50 seeds the obstacles exercise the full intent distribution and the
    drone never knows in advance which way they will go — this is the
    test bed where CVaR, adaptive fusion, and closed-loop intent
    correction earn their keep.

    Geometry roughly mirrors simple_box_dynamic_3.world so that paper
    comparisons against the deterministic baseline are apples-to-apples.

    Pedestrians:
      person1_branch    starts at (2.8, -2.0), commits at (2.8, 0.0)
        60% : keep going straight to (2.8, 2.0)
        40% : turn LEFT  to (0.8, 0.0)
      person2_branch    starts at (5.0, -2.0), commits at (5.0, 0.0)
        50% : keep going straight to (5.0, 2.0)
        50% : turn RIGHT to (7.0, 0.0)
      person3_static    deterministic control (no branching)
  -->
  <world name='default'>

    <!-- ─────────────────────  Pedestrian 1 (branching)  ──────────────────── -->
    <model name="person1_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry>
            <mesh><uri>model://person/meshes/walking.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <!-- pre-branch approach -->
          <waypoint>2.8 -2.0 0.0</waypoint>
          <waypoint>2.8  0.0 0.0</waypoint>
          <!-- decision point -->
          <branch_point>
            <choice prob="0.6">
              <waypoint>2.8 2.0 0.0</waypoint>
            </choice>
            <choice prob="0.4">
              <waypoint>0.8 0.0 0.0</waypoint>
              <waypoint>0.8 2.0 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- ─────────────────────  Pedestrian 2 (branching)  ──────────────────── -->
    <model name="person2_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry>
            <mesh><uri>model://person/meshes/walking.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>5.0 -2.0 0.0</waypoint>
          <waypoint>5.0  0.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.5">
              <waypoint>5.0 2.0 0.0</waypoint>
            </choice>
            <choice prob="0.5">
              <waypoint>7.0 0.0 0.0</waypoint>
              <waypoint>7.0 2.0 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- ─────────────────────  Pedestrian 3 (deterministic)  ─────────────── -->
    <model name="person3_static_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry>
            <mesh><uri>model://person/meshes/walking.dae</uri></mesh>
          </geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>7.5 0.0 0.0</waypoint>
          <waypoint>7.5 2.0 0.0</waypoint>
        </path>
      </plugin>
    </model>

    <!-- ─────────────────────  Standard world environment  ──────────────── -->
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <contact><collide_bitmask>65535</collide_bitmask><ode/></contact>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode><torsional><ode/></torsional></friction>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
        <self_collide>0</self_collide>
        <enable_wind>0</enable_wind>
        <kinematic>0</kinematic>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
