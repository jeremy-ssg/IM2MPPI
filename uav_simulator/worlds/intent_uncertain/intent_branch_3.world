<sdf version='1.7'>
  <!--
    Intent-uncertain benchmark world.

    This file intentionally contains dynamic pedestrians only; the planner-side
    static prebuilt map is disabled by the intent-uncertain launch files.

    The filename is kept for backward compatibility with existing commands, but
    the scene now has 8 pedestrians, matching the scale of the previous dynamic
    benchmark.  Most pedestrians contain one branch point.  At Gazebo load time,
    obstaclePathPlugin samples one branch per pedestrian using OBS_BRANCH_SEED
    mixed with the model name hash, so every method sees the same sampled
    motions for a given seed while different seeds cover different intents.
  -->
  <world name='default'>

    <!-- Pedestrian 1: east-side vertical crossing, straight or left-turn. -->
    <model name="person1_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>2.8 -2.0 0.0</waypoint>
          <waypoint>2.8  0.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.6">
              <waypoint>2.8 2.0 0.0</waypoint>
            </choice>
            <choice prob="0.4">
              <waypoint>0.8 0.0 0.0</waypoint>
              <waypoint>0.8 2.0 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 2: east-side vertical crossing, straight or right-turn. -->
    <model name="person2_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>5.0 -2.0 0.0</waypoint>
          <waypoint>5.0  0.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.5">
              <waypoint>5.0 2.0 0.0</waypoint>
            </choice>
            <choice prob="0.5">
              <waypoint>7.0 0.0 0.0</waypoint>
              <waypoint>7.0 2.0 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 3: west-side vertical crossing, straight or right-turn. -->
    <model name="person3_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>-2.8 2.0 0.0</waypoint>
          <waypoint>-2.8 0.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.55">
              <waypoint>-2.8 -2.0 0.0</waypoint>
            </choice>
            <choice prob="0.45">
              <waypoint>-0.8 0.0 0.0</waypoint>
              <waypoint>-0.8 -2.0 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 4: west-side vertical crossing, straight or outer turn. -->
    <model name="person4_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>-5.0 2.0 0.0</waypoint>
          <waypoint>-5.0 0.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.5">
              <waypoint>-5.0 -2.0 0.0</waypoint>
            </choice>
            <choice prob="0.5">
              <waypoint>-7.0 0.0 0.0</waypoint>
              <waypoint>-7.0 -2.0 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 5: upper corridor crossing near the circular route. -->
    <model name="person5_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>-2.0 5.0 0.0</waypoint>
          <waypoint>0.0 5.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.65">
              <waypoint>2.0 5.0 0.0</waypoint>
            </choice>
            <choice prob="0.35">
              <waypoint>0.0 6.8 0.0</waypoint>
              <waypoint>2.0 6.8 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 6: lower corridor crossing near the circular route. -->
    <model name="person6_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>2.0 -5.0 0.0</waypoint>
          <waypoint>0.0 -5.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.6">
              <waypoint>-2.0 -5.0 0.0</waypoint>
            </choice>
            <choice prob="0.4">
              <waypoint>0.0 -6.8 0.0</waypoint>
              <waypoint>-2.0 -6.8 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 7: upper-left diagonal, straight or inward turn. -->
    <model name="person7_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>-6.2 4.4 0.0</waypoint>
          <waypoint>-4.6 3.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.5">
              <waypoint>-3.0 1.6 0.0</waypoint>
            </choice>
            <choice prob="0.5">
              <waypoint>-6.0 1.6 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <!-- Pedestrian 8: upper-right diagonal, straight or inward turn. -->
    <model name="person8_branch_0.5_0.5_1.8">
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="bottom">
          <pose>0 0 0.01 0 0 1.57</pose>
          <geometry><box><size>0.35 0.75 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <pose>0 0 -0.02 0 0 1.57</pose>
          <geometry><mesh><uri>model://person/meshes/walking.dae</uri></mesh></geometry>
        </visual>
      </link>
      <plugin name="obstacle_motion" filename="libobstaclePathPlugin.so">
        <loop>0</loop>
        <velocity>0.5</velocity>
        <angular_velocity>0.8</angular_velocity>
        <path>
          <waypoint>6.2 4.4 0.0</waypoint>
          <waypoint>4.6 3.0 0.0</waypoint>
          <branch_point>
            <choice prob="0.5">
              <waypoint>3.0 1.6 0.0</waypoint>
            </choice>
            <choice prob="0.5">
              <waypoint>6.0 1.6 0.0</waypoint>
            </choice>
          </branch_point>
        </path>
      </plugin>
    </model>

    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name='ground_plane'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface>
            <contact><collide_bitmask>65535</collide_bitmask><ode/></contact>
            <friction><ode><mu>100</mu><mu2>50</mu2></ode><torsional><ode/></torsional></friction>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    <wind/>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>
  </world>
</sdf>
